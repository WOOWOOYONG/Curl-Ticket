{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../../",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "#shared/*": ["../../shared/*"]
    }
  },
  "include": ["src", "../../shared"]
}
