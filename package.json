{
  "name": "curl-ticket",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:login": "bash ./scripts/dev-login-agent.sh",
    "dev:login-required": "bash ./scripts/dev-login-required-agent.sh",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && lefthook install",
    "prepare": "lefthook install",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:types": "supabase gen types typescript --project-id wngvnvceyvqlrebuvsyh > app/types/database.types.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@iconify-json/simple-icons": "^1.2.67",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/i18n": "^10.2.4",
    "@nuxtjs/supabase": "2.0.3",
    "@supabase/supabase-js": "^2.93.2",
    "@vueuse/nuxt": "14.1.0",
    "curlconverter": "^4.12.0",
    "drizzle-orm": "^0.45.1",
    "isomorphic-dompurify": "^3.10.0",
    "markdown-it": "^14.1.1",
    "nuxt": "^4.2.2",
    "postgres": "^3.4.8",
    "sanitize-html": "^2.17.2",
    "shiki": "^3.22.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint-plugin": "^1.15.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.0.18",
    "agent-browser": "^0.13.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.1.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "supabase": "^2.72.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
