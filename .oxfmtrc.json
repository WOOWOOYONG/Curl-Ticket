{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "singleAttributePerLine": true,
  "vueIndentScriptAndStyle": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist",
    "server/database/migrations",
    ".agents",
    ".claude",
    ".codes",
    ".codex",
    ".github",
    ".vscode",
    "docs",
    "notes",
    "openspec",
    "todo",
    "coverage",
    "public"
  ]
}
