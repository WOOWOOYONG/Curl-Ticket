# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Database Connection (從 Supabase Dashboard > Settings > Database > Connection string 取得)
# 使用 Transaction pooler (port 6543) 並選擇你的 region
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Local Dev Login (API)
DEV_LOGIN_EMAIL=dev-user@example.com
DEV_LOGIN_PASSWORD=your_dev_password
DEV_LOGIN_KEY=your_dev_login_key
